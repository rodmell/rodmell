generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  username     String        @unique
  password     String
  role         Role          @default(SELLER)
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ubicacion    Ubicacion     @default(CASA_CENTRAL)
  activityLogs ActivityLog[]
  operaciones  Operacion[]
}

model Cliente {
  id                 String             @id @default(cuid())
  nombreCompleto     String
  dni                String?
  cuil               String?
  estadoCivil        String?
  conyuge            String?
  direccion          String?
  telefono           String?
  email              String?
  observaciones      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  creditosHistoricos CreditoHistorico[]
  documentos         Documento[]
  operaciones        Operacion[]
  servicios          Servicio[]
}

model Vehiculo {
  id            String         @id @default(cuid())
  tipo          TipoVehiculo   @default(AUTO)
  marca         String
  modelo        String
  anio          Int
  dominio       String
  chasis        String?
  color         String?
  kilometros    Int?
  precioVenta   Float
  precioCosto   Float?
  precioFactura Float?
  precioUSD     Float?
  condicion     String?
  descripcion   String?
  estado        EstadoVehiculo @default(DISPONIBLE)
  fotos         String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  combustible   String?
  destacado     Boolean        @default(false)
  transmision   String?
  ubicacion     Ubicacion      @default(CASA_CENTRAL)
  documentos    Documento[]
  operaciones   Operacion[]
}

model Operacion {
  id                   String      @id @default(cuid())
  clienteId            String
  vehiculoId           String
  vendedorId           String
  precioVehiculo       Float
  formaPago            String?
  efectivo             Float?
  credito              Float?
  autoPartePago        Float?
  detalleAutoPartePago String?
  porcentajeQuebranto  Float?
  gastosInscripcion    Float?
  gastosPrenda         Float?
  accesorios           Float?
  quebranto            Float?
  observaciones        String?
  total                Float
  saldoPendiente       Float
  comprobante          String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  confirmado           Boolean     @default(false)
  gastosPatente        Float?
  gastosPrendarios     Float?
  gastosTransferencia  Float?
  cuotas               Cuota[]
  documentos           Documento[]
  gastos               Gasto[]
  cliente              Cliente     @relation(fields: [clienteId], references: [id])
  vehiculo             Vehiculo    @relation(fields: [vehiculoId], references: [id])
  vendedor             User        @relation(fields: [vendedorId], references: [id])
  pagos                Pago[]
  servicios            Servicio[]
}

model Pago {
  id             String    @id @default(cuid())
  operacionId    String
  fecha          DateTime
  importe        Float
  medioPago      MedioPago
  observaciones  String?
  comprobante    String?   @unique
  comprobanteUrl String?
  operacion      Operacion @relation(fields: [operacionId], references: [id])
}

model Cuota {
  id               String      @id @default(cuid())
  operacionId      String
  numeroCuota      Int
  valor            Float
  fechaVencimiento DateTime
  estado           EstadoCuota @default(PENDIENTE)
  medioPago        MedioPago?
  fechaPago        DateTime?
  comprobante      String?     @unique
  comprobanteUrl   String?
  operacion        Operacion   @relation(fields: [operacionId], references: [id])
}

model Gasto {
  id          String        @id @default(cuid())
  operacionId String
  concepto    ConceptoGasto
  monto       Float
  fecha       DateTime
  operacion   Operacion     @relation(fields: [operacionId], references: [id])
}

model Documento {
  id            String        @id @default(cuid())
  operacionId   String?
  clienteId     String?
  vehiculoId    String?
  tipo          TipoDocumento
  url           String
  nombreArchivo String
  observaciones String?
  cliente       Cliente?      @relation(fields: [clienteId], references: [id])
  operacion     Operacion?    @relation(fields: [operacionId], references: [id])
  vehiculo      Vehiculo?     @relation(fields: [vehiculoId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model CreditoHistorico {
  id              String           @id @default(cuid())
  clienteId       String
  descripcion     String
  totalFinanciado Float
  cantidadCuotas  Int
  valorCuota      Float
  intereses       Float?           @default(0)
  fechaInicio     DateTime
  observaciones   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  cuotas          CuotaHistorica[]
}

model CuotaHistorica {
  id               String           @id @default(cuid())
  creditoId        String
  numeroCuota      Int
  valor            Float
  fechaVencimiento DateTime
  estado           EstadoCuota      @default(PENDIENTE)
  fechaPago        DateTime?
  montoPagado      Float?
  credito          CreditoHistorico @relation(fields: [creditoId], references: [id])
}

model CatalogoServicio {
  id          String       @id @default(cuid())
  tipo        TipoServicio
  descripcion String
  monto       Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Servicio {
  id            String       @id @default(cuid())
  clienteId     String
  operacionId   String?
  tipo          TipoServicio
  descripcion   String
  monto         Float
  pagado        Boolean      @default(false)
  fecha         DateTime     @default(now())
  observaciones String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  operacion     Operacion?   @relation(fields: [operacionId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  ADMIN_STAFF
  WORKSHOP
}

enum EstadoVehiculo {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ENTREGADO
  CONSIGNADO
}

enum TipoVehiculo {
  AUTO
  MOTO
}

enum MedioPago {
  SENA
  TRANSFERENCIA
  EFECTIVO
  TARJETA
  OTROS
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  VENCIDA
}

enum ConceptoGasto {
  PATENTE
  INSCRIPCION
  PRENDA
  GESTORIA
  ACCESORIOS
  OTROS
}

enum TipoDocumento {
  DNI
  FORMULARIO
  CONTRATO
  PDF
  OTRO
}

enum Ubicacion {
  CASA_CENTRAL
  SUCURSAL_J_IBARRA
}

enum TipoServicio {
  ACCESORIO
  POLARIZADO
  GNC
  ALARMA
  SERVICE
  OTROS
}
